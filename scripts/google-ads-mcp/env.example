# Copy to:  ~/.config/jd-studio/google-ads.env
#   mkdir -p ~/.config/jd-studio && cp scripts/google-ads-mcp/env.example ~/.config/jd-studio/google-ads.env
# Fill values from Manus / production Google Ads sync (same as server/googleAds.ts).
# NEVER commit the real google-ads.env file.

GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# Manager (MCC) account — used as login-customer-id (digits only or with dashes OK)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=9876630892

# GCP project that owns the OAuth client (Cloud Console → project id string)
GOOGLE_PROJECT_ID=

# Optional: advertising account for prompts (not required by MCP server)
# GOOGLE_ADS_AD_ACCOUNT_ID=4839352747
