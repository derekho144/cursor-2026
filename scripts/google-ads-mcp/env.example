# Shared Google Ads credentials for JD Studio, gads-cli, ARBA, MCP, weekly QS review.
#
# Copy to:  ~/.config/jd-studio/google-ads.env
#   mkdir -p ~/.config/jd-studio && cp scripts/google-ads-mcp/env.example ~/.config/jd-studio/google-ads.env
#
# Or export from production:
#   npx tsx scripts/google-ads-mcp/export-local-env.ts > ~/.config/jd-studio/google-ads.env
#
# NEVER commit the real google-ads.env file.

# ── Core (server + gads-cli + ARBA) ─────────────────────────────────────────
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# Manager (MCC) — login-customer-id
GOOGLE_ADS_CUSTOMER_ID=9876630892
GOOGLE_ADS_LOGIN_CUSTOMER_ID=9876630892

# Ad account with campaigns/metrics (server/googleAds.ts + gads-cli)
GOOGLE_ADS_AD_ACCOUNT_ID=4839352747

# Optional: inferred from GOOGLE_ADS_CLIENT_ID prefix if omitted
GOOGLE_PROJECT_ID=

# ── ARBA (google-marketing-solutions/arba) ───────────────────────────────────
# ARBA reads google-ads.yaml — auto-generated by:
#   source scripts/google-ads-credentials.sh && google_ads_write_arba_yaml
# Default path: ~/.config/jd-studio/google-ads.yaml
#
# GEMINI_API_KEY=          # ARBA Gemini tagging (optional)
# GOOGLE_CLOUD_PROJECT=    # ARBA BigQuery / Cloud Run
# BQ_DATASET=arba
# ADS_CONFIG=~/.config/jd-studio/google-ads.yaml

# ── Override path ───────────────────────────────────────────────────────────
# GOOGLE_ADS_ENV_FILE=~/.config/jd-studio/google-ads.env
# GOOGLE_ADS_YAML_FILE=~/.config/jd-studio/google-ads.yaml
