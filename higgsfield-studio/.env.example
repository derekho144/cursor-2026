# Server-side Higgsfield API base (do not change for production).
HF_API_BASE_URL=https://api.higgsfield.ai

# Optional shared server key — paste the complete credential from
# https://open.higgsfield.ai/api-keys as-is (often looks like id:secret).
# When set, Studio can generate without the Connect API key cookie.
# Prefer Connect API key for per-browser keys; use this for a shared deploy.
# HF_API_KEY=
