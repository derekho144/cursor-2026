# Manus production deploy (GitHub main → JD SYS → checkpoint → publish)
# Copy to .env or set as Cloud Agent secrets.

MANUS_API_KEY=
# Preferred: explicit JD SYS project task (manus-1.6-lite)
MANUS_PROJECT_TASK_ID=8b23sC2fWWQJLaDHXQRwZX
# Legacy alias — scripts ignore non-project Ads / retired error tasks and fall back to JD SYS
MANUS_TASK_ID=8b23sC2fWWQJLaDHXQRwZX
MANUS_AGENT_PROFILE=manus-1.6-lite
MANUS_WEBSITE_ID=VbnWSJV6UQ79sGuykqPPae
MANUS_API_BASE=https://api.manus.ai

# Trusted campaign PHRASE negatives daily auto-exec (default on). Set 0 to disable.
# TRUSTED_NEGATIVES_AUTO=0

# WhatsApp Cloud API (Meta) — auto-match inbound chats → Google Ads clicks
# Webhook URL in Meta: https://jdsys.biz/api/webhooks/whatsapp
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=jd-studio-wa-verify
# WHATSAPP_APP_SECRET=
